# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/claudeskills

# --- Stripe (von dir auszufüllen) ---
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_ID=price_REPLACE_ME

# --- Admin ---
ADMIN_EMAIL=daniel@example.com
ADMIN_PASSWORD=changeMeOnFirstLogin
SESSION_SECRET=generate_a_long_random_string_here

# --- Storage ---
# Verzeichnis für die Skill-ZIPs (im Container ein Volume)
STORAGE_DIR=/var/data/claude-skills

# --- E-Mail (Resend oder SMTP) ---
EMAIL_FROM=hi@claudeskills.shop
RESEND_API_KEY=re_REPLACE_ME
# Fallback: SMTP_HOST=...

# --- Pricing ---
PRICE_EUR=9900
